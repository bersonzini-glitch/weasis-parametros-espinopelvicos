<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Parámetros espinopélvicos para Weasis</title>
    <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
    <options customize="never" require-scripts="true"/>
    <welcome file="welcome.html" mime-type="text/html"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <choices-outline>
        <line choice="plugin"/>
    </choices-outline>
    <choice id="plugin" visible="false">
        <pkg-ref id="com.columnaspine.weasis.spinopelvic"/>
    </choice>
    <pkg-ref id="com.columnaspine.weasis.spinopelvic" version="VERSION">plugin.pkg</pkg-ref>
</installer-gui-script>
